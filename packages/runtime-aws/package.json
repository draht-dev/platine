{
  "name": "@draht/runtime-aws",
  "version": "0.0.1",
  "description": "draht agent framework — AWS serverless runtime (Lambda + SQS + DynamoDB + EventBridge). Executor + AWS seam implementations.",
  "license": "Apache-2.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./handlers": {
      "types": "./dist/handlers/index.d.ts",
      "import": "./dist/handlers/index.js",
      "require": "./dist/handlers/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1071.0",
    "@aws-sdk/client-eventbridge": "^3.1071.0",
    "@aws-sdk/client-sqs": "^3.1071.0",
    "@aws-sdk/lib-dynamodb": "^3.1071.0",
    "@draht/core": "workspace:*",
    "@draht/manifest": "workspace:*",
    "@draht/model": "workspace:*",
    "electrodb": "^3.7.5"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "aws-sdk-client-mock": "^4.1.0",
    "dynamodb-local": "^0.0.38",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.3"
  }
}
