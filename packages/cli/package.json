{
  "name": "@draht/platine",
  "version": "0.0.1",
  "description": "platine CLI — the draht agent framework command-line interface. `platine init`, `platine dev`, `platine build`, `platine deploy`, `platine runs`.",
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "platine": "./dist/index.cjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@draht/core": "workspace:*",
    "@draht/manifest": "workspace:*",
    "@draht/model": "workspace:*",
    "@draht/runtime-aws": "workspace:*",
    "tsx": "^4.22.4"
  },
  "optionalDependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1071.0",
    "@aws-sdk/client-dynamodb": "^3.1071.0",
    "@aws-sdk/lib-dynamodb": "^3.1071.0",
    "@aws-sdk/client-sqs": "^3.1071.0",
    "@anthropic-ai/sdk": "^0.54.0"
  },
  "devDependencies": {
    "@types/node": "^20.19.0",
    "tsup": "^8.5.0",
    "typescript": "~5.9.0",
    "vitest": "^3.2.3",
    "zod": "^3.25.76"
  }
}
