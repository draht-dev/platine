{
  "name": "@draht/example-reference-playbook",
  "version": "0.0.1",
  "description": "draht reference playbook — support-triage single-agent workflow with one approval-gated tool. Full authoring→compile→deploy→run.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsx ../../packages/cli/dist/index.cjs build --skip-typecheck",
    "build:check": "tsx ../../packages/cli/dist/index.cjs build",
    "typecheck": "tsgo --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@draht/core": "workspace:*",
    "@draht/runtime-aws": "workspace:*",
    "@draht/sst": "workspace:*",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@draht/platine": "workspace:*",
    "@types/node": "^20.19.0",
    "tsx": "^4.19.4",
    "typescript": "~5.9.0",
    "vitest": "^3.2.3"
  }
}
